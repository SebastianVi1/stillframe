<Window x:Class="Stillframe.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Stillframe Settings" Width="900" Height="760" MinWidth="700" MinHeight="580" WindowStartupLocation="CenterScreen" Style="{StaticResource {x:Type Window}}">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="285" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource Surface}" Padding="26,32">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="16" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel>
          <StackPanel Orientation="Horizontal"><Border Width="30" Height="30" Background="{DynamicResource Accent}" CornerRadius="8" Margin="0,0,10,0"><TextBlock Text="▧" Foreground="{DynamicResource OnAccent}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="Stillframe" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center" /></StackPanel>
          <TextBlock Text="Your photos. A place on your desktop." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="13" Margin="0,14,0,24" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" Padding="0,0,5,0"><StackPanel>
          <Border Height="170" CornerRadius="12" Background="{DynamicResource Canvas}">
            <Grid x:Name="PreviewSurface" SizeChanged="PreviewSizeChanged"><Image x:Name="PreviewImage" Stretch="UniformToFill" /><StackPanel x:Name="PreviewEmpty" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="▧" FontSize="36" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" /><TextBlock Text="Your next favorite view" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,8,0,0" /></StackPanel></Grid>
          </Border>
          <TextBlock x:Name="PhotoName" Text="No folder selected" FontWeight="SemiBold" Margin="0,14,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
          <TextBlock x:Name="PhotoCount" Text="0 photos" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,5,0,16" />
          <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
            <Button Content="←" Click="PreviousClicked" Padding="8" Margin="0,0,5,0" AutomationProperties.Name="Previous photo" ToolTip="Previous photo" />
            <Button x:Name="PlayButton" Grid.Column="1" Content="Pause" Click="PlayClicked" Padding="8" Margin="0,0,5,0" AutomationProperties.Name="Pause slideshow" />
            <Button Grid.Column="2" Content="→" Click="NextClicked" Padding="8" AutomationProperties.Name="Next photo" ToolTip="Next photo" />
          </Grid>
          <Button Content="Edit layout" Click="EditClicked" Margin="0,16,0,0" />
          <Button x:Name="LockButton" Content="Lock to desktop" Click="LockClicked" Visibility="Collapsed" Margin="0,8,0,0" Style="{StaticResource PrimaryButton}" />
          <TextBlock Text="Move the frame in edit mode. Lock it when you're done." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,10,0,0" />
        </StackPanel></ScrollViewer>
        <StackPanel Grid.Row="3">
          <Border Background="{DynamicResource Canvas}" CornerRadius="8" Padding="12"><StackPanel><TextBlock Text="DESKTOP CONNECTION" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" /><TextBlock x:Name="ConnectionText" Text="Connecting…" TextWrapping="Wrap" FontSize="12" /></StackPanel></Border>
          <Button Content="Reconnect to desktop" Click="ReconnectClicked" Margin="0,10,0,0" Padding="8" FontSize="12" />
          <TextBlock Text="Local photos · Windows 11 · v0.1" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,18,0,0" />
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="30,30,26,20">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <StackPanel Margin="0,0,0,22"><TextBlock Text="Make room for memories." FontSize="27" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="Choose a folder. We'll take care of the view." Foreground="{DynamicResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap" /></StackPanel>
      <ScrollViewer Grid.Row="1" Padding="0,0,12,0">
        <StackPanel>
          <TextBlock Text="PHOTO FOLDER" Style="{StaticResource SectionLabel}" />
          <Label Content="Folder path" Target="{Binding ElementName=FolderBox}" Padding="0,0,0,5" Foreground="{DynamicResource Muted}" FontSize="12" />
          <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="FolderBox" AutomationProperties.Name="Photo folder path" /><Button Grid.Column="1" Content="Browse…" Click="BrowseClicked" Margin="10,0,0,0" /></Grid>
          <TextBlock Text="JPG, JPEG, PNG and BMP. Your originals stay untouched." Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
          <CheckBox x:Name="SubfoldersBox" Content="Include subfolders" />
          <Button Content="Try Windows sample photos" Click="SamplesClicked" HorizontalAlignment="Left" Padding="12,7" MinHeight="34" Margin="0,12,0,0" FontSize="12" />
          <Border Height="1" Background="{DynamicResource Line}" Margin="0,24,0,22" />
          <TextBlock Text="SLIDESHOW" Style="{StaticResource SectionLabel}" />
          <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0"><Label Content="Time per photo (seconds)" Target="{Binding ElementName=IntervalBox}" Foreground="{DynamicResource Muted}" Padding="0,0,0,6" FontSize="12" /><TextBox x:Name="IntervalBox" AutomationProperties.Name="Time per photo in seconds" /></StackPanel>
            <StackPanel Grid.Column="1"><Label Content="Photo order" Target="{Binding ElementName=OrderBox}" Foreground="{DynamicResource Muted}" Padding="0,0,0,6" FontSize="12" /><ComboBox x:Name="OrderBox" AutomationProperties.Name="Photo order"><ComboBoxItem Content="Filename" /><ComboBoxItem Content="Modification date" /><ComboBoxItem Content="Shuffle" /></ComboBox></StackPanel>
          </Grid>
          <TextBlock Text="2–3,600 seconds. Shuffle plays each photo before repeating." Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
          <Border Height="1" Background="{DynamicResource Line}" Margin="0,24,0,22" />
          <TextBlock Text="FRAME &amp; MOTION" Style="{StaticResource SectionLabel}" />
          <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0"><Label Content="Image placement" Target="{Binding ElementName=FitBox}" Foreground="{DynamicResource Muted}" Padding="0,0,0,6" FontSize="12" /><ComboBox x:Name="FitBox" AutomationProperties.Name="Image placement"><ComboBoxItem Content="Fit — show the whole photo" /><ComboBoxItem Content="Fill — crop to the frame" /></ComboBox></StackPanel>
            <StackPanel Grid.Column="1"><Label Content="Frame shape" Target="{Binding ElementName=ShapeBox}" Foreground="{DynamicResource Muted}" Padding="0,0,0,6" FontSize="12" /><ComboBox x:Name="ShapeBox" SelectionChanged="ShapeChanged" AutomationProperties.Name="Frame shape"><ComboBoxItem Content="Landscape" /><ComboBoxItem Content="Square" /><ComboBoxItem Content="Portrait" /><ComboBoxItem Content="Custom" /></ComboBox></StackPanel>
          </Grid>
          <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,10,0"><Label Content="Width" Target="{Binding ElementName=WidthBox}" Foreground="{DynamicResource Muted}" Padding="0,0,0,6" FontSize="12" /><TextBox x:Name="WidthBox" AutomationProperties.Name="Frame width" /></StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,10,0"><Label Content="Height" Target="{Binding ElementName=HeightBox}" Foreground="{DynamicResource Muted}" Padding="0,0,0,6" FontSize="12" /><TextBox x:Name="HeightBox" AutomationProperties.Name="Frame height" /></StackPanel>
            <StackPanel Grid.Column="2"><Label Content="Display" Target="{Binding ElementName=MonitorBox}" Foreground="{DynamicResource Muted}" Padding="0,0,0,6" FontSize="12" /><ComboBox x:Name="MonitorBox" AutomationProperties.Name="Display" /></StackPanel>
          </Grid>
          <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0"><Label Content="Left (screen pixels)" Target="{Binding ElementName=XBox}" Foreground="{DynamicResource Muted}" Padding="0,0,0,6" FontSize="12" /><TextBox x:Name="XBox" AutomationProperties.Name="Frame left position" /></StackPanel>
            <StackPanel Grid.Column="1"><Label Content="Top (screen pixels)" Target="{Binding ElementName=YBox}" Foreground="{DynamicResource Muted}" Padding="0,0,0,6" FontSize="12" /><TextBox x:Name="YBox" AutomationProperties.Name="Frame top position" /></StackPanel>
          </Grid>
          <CheckBox x:Name="CenterPeopleBox" Content="Keep people centered in Fill mode" />
          <TextBlock Text="Leaves room around faces. Shows the whole photo when a group cannot fit. Photos are processed on this device." Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
          <CheckBox x:Name="ZoomBox" Content="Slow zoom in Fill mode" />
          <CheckBox x:Name="ReducedBox" Content="Reduce motion" />
          <TextBlock Text="Windows animation preferences are always respected." Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
          <Border Height="1" Background="{DynamicResource Line}" Margin="0,24,0,22" />
          <TextBlock Text="WINDOWS" Style="{StaticResource SectionLabel}" />
          <CheckBox x:Name="StartupBox" Content="Start Stillframe when I sign in" Margin="0" />
          <TextBlock Text="Closing Settings keeps your photos on the desktop. Use the tray icon to open Settings or exit." Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,10,0,18" TextWrapping="Wrap" />
        </StackPanel>
      </ScrollViewer>
      <StackPanel Grid.Row="2" Margin="0,16,0,0">
        <TextBlock x:Name="StatusText" Text="Ready when you are." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="12" MinHeight="34" AutomationProperties.LiveSetting="Polite" />
        <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <Button Content="Refresh photos" Click="RefreshClicked" HorizontalAlignment="Left" />
          <Button x:Name="ApplyButton" Grid.Column="1" Content="Apply settings" Click="ApplyClicked" Style="{StaticResource PrimaryButton}" MinWidth="146" />
        </Grid>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
