<Window x:Class="Stillframe.WidgetWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Stillframe.Controls"
 Title="Stillframe photo widget" Width="360" Height="240" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="False" Background="Transparent" ShowInTaskbar="False" ShowActivated="False" Style="{StaticResource {x:Type Window}}" UseLayoutRounding="True">
  <Window.Resources>
    <Style x:Key="PhotoNavigationButton" TargetType="Button">
      <Setter Property="Width" Value="36" /><Setter Property="Height" Value="36" />
      <Setter Property="MinWidth" Value="36" /><Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="0" /><Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="#F7F8FA" /><Setter Property="Background" Value="#CE181A1D" />
      <Setter Property="BorderBrush" Value="#55FFFFFF" /><Setter Property="BorderThickness" Value="1" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Chrome" CornerRadius="18" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#F0373B42" /><Setter TargetName="Chrome" Property="BorderBrush" Value="#B0FFFFFF" /></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#FF111316" /></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}" /><Setter TargetName="Chrome" Property="BorderThickness" Value="2" /></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45" /></Trigger>
          <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" /><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" /><Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" /></DataTrigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid x:Name="FrameRoot" MouseEnter="FrameMouseEnter" MouseLeave="FrameMouseLeave" IsKeyboardFocusWithinChanged="FrameKeyboardFocusChanged">
    <Border CornerRadius="16" Background="{DynamicResource Canvas}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
    </Border>
    <Grid x:Name="PhotoSurface" SizeChanged="SurfaceSizeChanged" Background="{DynamicResource Canvas}">
      <controls:PhotoImage x:Name="BackImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.5,0.5"><Image.RenderTransform><ScaleTransform /></Image.RenderTransform></controls:PhotoImage>
      <controls:PhotoImage x:Name="FrontImage" Stretch="UniformToFill" Opacity="0" RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.5,0.5"><Image.RenderTransform><ScaleTransform /></Image.RenderTransform></controls:PhotoImage>
      <StackPanel x:Name="EmptyState" Panel.ZIndex="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
        <TextBlock Text="▧" FontSize="32" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" />
        <TextBlock Text="A little space for your photos." Margin="0,12,0,0" FontWeight="SemiBold" TextAlignment="Center" />
        <TextBlock x:Name="EmptyCaption" Text="Choose a folder from Stillframe Settings." Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0" />
      </StackPanel>
      <Grid x:Name="NavigationOverlay" Panel.ZIndex="4" Opacity="0" IsHitTestVisible="False" Visibility="Collapsed" Margin="10,0">
        <Button x:Name="PreviousPhotoButton" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource PhotoNavigationButton}" Click="PreviousPhotoClicked" AutomationProperties.Name="Previous photo" ToolTip="Previous photo">
          <Path Data="M 8,1 L 2,7 L 8,13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="10" Height="14" />
        </Button>
        <Button x:Name="NextPhotoButton" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource PhotoNavigationButton}" Click="NextPhotoClicked" AutomationProperties.Name="Next photo" ToolTip="Next photo">
          <Path Data="M 2,1 L 8,7 L 2,13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="10" Height="14" />
        </Button>
      </Grid>
      <Border x:Name="EditOverlay" Panel.ZIndex="2" Background="#CA181A1D" VerticalAlignment="Bottom" Visibility="Collapsed" Padding="12">
        <StackPanel><TextBlock Text="Drag the frame to move it" FontSize="12" Margin="0,0,0,8" />
          <Button Content="Lock to desktop" Click="LockClicked" Style="{StaticResource PrimaryButton}" Padding="10,6" MinHeight="32" />
        </StackPanel>
      </Border>
      <Border x:Name="ResizeGrip" Panel.ZIndex="3" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="#D030343B" Visibility="Collapsed" Cursor="SizeNWSE" MouseLeftButtonDown="ResizeStart" MouseMove="ResizeMove" MouseLeftButtonUp="ResizeEnd" ToolTip="Drag to resize; exact size is also available in Settings">
        <TextBlock Text="◢" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" />
      </Border>
    </Grid>
  </Grid>
</Window>
